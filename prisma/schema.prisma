generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── MULTI-TENANCY ────────────────────────────────────────────────────────────────
model Tenant {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  plan      Plan     @default(FREE)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users            User[]
  projects         Project[]
  suppliers        Supplier[]
  emailConnections EmailConnection[]
  subscriptions    Subscription[]

  @@map("tenants")
}

enum Plan {
  FREE
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

// ─── AUTHENTICATION & USERS ─────────────────────────────────────────────────────
model User {
  id         String   @id @default(uuid())
  tenantId   String
  supabaseId String   @unique
  email      String
  firstName  String?
  lastName   String?
  role       UserRole @default(MEMBER)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@map("users")
}

enum UserRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

// ─── PROJECTS / AUFTRÄGE ──────────────────────────────────────────────────────
model Project {
  id          String        @id @default(uuid())
  tenantId    String
  name        String
  description String?
  location    String?
  status      ProjectStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  tenant               Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leistungsverzeichnis Leistungsverzeichnis[]
  inquiries            Inquiry[]

  @@map("projects")
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  AWAITING_OFFERS
  COMPARING
  AWARDED
  COMPLETED
  ARCHIVED
}

// ─── LEISTUNGSVERZEICHNIS (Service Specification) ────────────────────────────────────
model Leistungsverzeichnis {
  id               String           @id @default(uuid())
  projectId        String
  tenantId         String
  fileName         String
  storagePath      String
  mimeType         String           @default("application/pdf")
  extractionStatus ExtractionStatus @default(PENDING)
  extractedAt      DateTime?
  errorMessage     String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  positions Position[]

  @@map("leistungsverzeichnisse")
}

enum ExtractionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// ─── POSITIONS (Extracted Line Items) ────────────────────────────────────────────────
model Position {
  id                     String   @id @default(uuid())
  leistungsverzeichnisId String
  positionNumber         String
  shortText              String
  longText               String?
  unit                   String?
  quantity               Decimal? @db.Decimal(12, 3)
  trade                  String?
  sortOrder              Int      @default(0)
  createdAt              DateTime @default(now())

  leistungsverzeichnis Leistungsverzeichnis @relation(fields: [leistungsverzeichnisId], references: [id], onDelete: Cascade)
  offerItems           OfferItem[]

  @@map("positions")
}

// ─── LIEFERANTEN (Suppliers) ───────────────────────────────────────────────────────
model Supplier {
  id          String   @id @default(uuid())
  tenantId    String
  companyName String
  contactName String?
  email       String
  phone       String?
  address     String?
  trade       String?
  notes       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inquiries Inquiry[]

  @@unique([tenantId, email])
  @@map("suppliers")
}

// ─── ANFRAGEN (Inquiries) ────────────────────────────────────────────────────────────────
model Inquiry {
  id             String        @id @default(uuid())
  projectId      String
  supplierId     String
  tenantId       String
  status         InquiryStatus @default(DRAFT)
  sentAt         DateTime?
  deadline       DateTime?
  portalToken    String        @unique @default(uuid())
  portalOpenedAt DateTime?
  emailMessageId String?
  notes          String?       
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  offers   Offer[]

  @@unique([projectId, supplierId])
  @@map("inquiries")
}

enum InquiryStatus {
  DRAFT
  SENT
  OPENED
  OFFER_RECEIVED
  DECLINED
  EXPIRED
}

// ─── ANGEBOTE (Offers) ────────────────────────────────────────────────────────────────
model Offer {
  id             String      @id @default(uuid())
  inquiryId      String
  tenantId       String
  source         OfferSource @default(PORTAL)
  totalNet       Decimal?    @db.Decimal(12, 2)
  totalGross     Decimal?    @db.Decimal(12, 2)
  vatRate        Decimal?    @db.Decimal(5, 2)
  currency       String      @default("EUR")
  validUntil     DateTime?
  notes          String?
  attachmentPath String?
  submittedAt    DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  inquiry    Inquiry     @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  offerItems OfferItem[]

  @@map("offers")
}

enum OfferSource {
  PORTAL
  EMAIL_ATTACHMENT
  MANUAL
}

// ─── ANGEBOTSPOSITIONEN (Offer Line Items) ───────────────────────────────────────────────
model OfferItem {
  id         String   @id @default(uuid())
  offerId    String
  positionId String
  unitPrice  Decimal? @db.Decimal(12, 4)
  totalPrice Decimal? @db.Decimal(12, 2)
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  offer    Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  position Position @relation(fields: [positionId], references: [id], onDelete: Cascade)

  @@unique([offerId, positionId])
  @@map("offer_items")
}

// ─── E-MAIL VERBINDUNG (Microsoft Graph) ──────────────────────────────────────────────────
model EmailConnection {
  id             String    @id @default(uuid())
  tenantId       String    @unique
  provider       String    @default("microsoft")
  accessToken    String?
  refreshToken   String?
  tokenExpiresAt DateTime?
  emailAddress   String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("email_connections")
}

// ─── PREISSPIEGEL (Price Comparison Export) ───────────────────────────────────────────────
model PriceComparison {
  id          String   @id @default(uuid())
  projectId   String   @unique
  tenantId    String
  exportPath  String?
  generatedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  @@map("price_comparisons")
}

// ─── SUBSCRIPTIONS / BILLING ─────────────────────────────────────────────────────────────────
model Subscription {
  id                   String             @id @default(uuid())
  tenantId             String             @unique
  plan                 Plan               @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  TRIALING
}

// ─── AUDIT LOG ──────────────────────────────────────────────────────────────────────────────
model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String
  userId     String?
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, createdAt])
  @@map("audit_logs")
}
