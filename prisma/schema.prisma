generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── MULTI-TENANCY ────────────────────────────────────────────────────────────────
model Tenant {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  logoUrl   String?
  plan      Plan     @default(FREE)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users            User[]
  projects         Project[]
  suppliers        Supplier[]
  emailConnections EmailConnection[]
  subscriptions    Subscription[]

  @@map("tenants")
}

enum Plan {
  FREE
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

// ─── AUTHENTICATION & USERS ─────────────────────────────────────────────────────
model User {
  id         String   @id @default(uuid())
  tenantId   String
  supabaseId String   @unique
  email      String
  firstName  String?
  lastName   String?
  role       UserRole @default(MEMBER)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@map("users")
}

enum UserRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

// ─── PROJECTS / AUFTRÄGE ──────────────────────────────────────────────────────
model Project {
  id          String        @id @default(uuid())
  tenantId    String
  name        String
  description String?
  location    String?
  status      ProjectStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  tenant               Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leistungsverzeichnis Leistungsverzeichnis[]
  inquiries            Inquiry[]
  priceAnomalies       PriceAnomaly[]
  invoices             Invoice[]

  @@map("projects")
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  AWAITING_OFFERS
  COMPARING
  AWARDED
  COMPLETED
  ARCHIVED
}

// ─── LEISTUNGSVERZEICHNIS (Service Specification) ────────────────────────────────────
model Leistungsverzeichnis {
  id               String           @id @default(uuid())
  projectId        String
  tenantId         String
  fileName         String
  storagePath      String
  mimeType         String           @default("application/pdf")
  extractionStatus ExtractionStatus @default(PENDING)
  extractedAt      DateTime?
  errorMessage     String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  positions Position[]

  @@map("leistungsverzeichnisse")
}

enum ExtractionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// ─── POSITIONS (Extracted Line Items) ────────────────────────────────────────────────
model Position {
  id                     String   @id @default(uuid())
  leistungsverzeichnisId String
  positionNumber         String
  shortText              String
  longText               String?
  unit                   String?
  quantity               Decimal? @db.Decimal(12, 3)
  trade                  String?
  sortOrder              Int      @default(0)
  createdAt              DateTime @default(now())

  leistungsverzeichnis Leistungsverzeichnis @relation(fields: [leistungsverzeichnisId], references: [id], onDelete: Cascade)
  offerItems           OfferItem[]
  inquiryPositions     InquiryPosition[]
  priceAnomalies       PriceAnomaly[]
  invoiceItems         InvoiceItem[]

  @@map("positions")
}

// ─── LIEFERANTEN (Suppliers) ───────────────────────────────────────────────────────
model Supplier {
  id          String      @id @default(uuid())
  tenantId    String
  companyName String
  salutation  Salutation?
  contactName String?
  email       String
  phone       String?
  address     String?
  trade       String?
  notes       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inquiries Inquiry[]
  score     SupplierScore?

  @@unique([tenantId, email])
  @@map("suppliers")
}

// Anrede des Ansprechpartners für eine förmliche, geschlechtsspezifische Anrede.
enum Salutation {
  HERR
  FRAU
}

// ─── ANFRAGEN (Inquiries) ────────────────────────────────────────────────────────────────
model Inquiry {
  id             String        @id @default(uuid())
  projectId      String
  supplierId     String
  tenantId       String
  status         InquiryStatus @default(DRAFT)
  sentAt         DateTime?
  deadline       DateTime?
  portalToken    String        @unique @default(uuid())
  portalOpenedAt DateTime?
  emailMessageId String?
  notes          String?       
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  supplier Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  offers    Offer[]
  invoices  Invoice[]
  positions InquiryPosition[]

  @@unique([projectId, supplierId])
  @@map("inquiries")
}


model InquiryPosition {
  id         String   @id @default(uuid())
  inquiryId  String
  positionId String
  createdAt  DateTime @default(now())

  inquiry  Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  position Position @relation(fields: [positionId], references: [id], onDelete: Cascade)

  @@unique([inquiryId, positionId])
  @@index([positionId])
  @@map("inquiry_positions")
}

enum InquiryStatus {
  DRAFT
  SENT
  OPENED
  OFFER_RECEIVED
  DECLINED
  EXPIRED
}

// ─── ANGEBOTE (Offers) ────────────────────────────────────────────────────────────────
model Offer {
  id             String      @id @default(uuid())
  inquiryId      String
  tenantId       String
  source         OfferSource @default(PORTAL)
  totalNet       Decimal?    @db.Decimal(12, 2)
  totalGross     Decimal?    @db.Decimal(12, 2)
  vatRate        Decimal?    @db.Decimal(5, 2)
  currency       String      @default("EUR")
  validUntil     DateTime?
  notes          String?
  attachmentPath String?
  submittedAt    DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  inquiry    Inquiry     @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  offerItems OfferItem[]

  @@map("offers")
}

enum OfferSource {
  PORTAL
  EMAIL_ATTACHMENT
  MANUAL
}

// ─── ANGEBOTSPOSITIONEN (Offer Line Items) ───────────────────────────────────────────────
model OfferItem {
  id              String   @id @default(uuid())
  offerId         String
  positionId      String
  unitPrice       Decimal? @db.Decimal(12, 4)
  totalPrice      Decimal? @db.Decimal(12, 2)
  notes           String?
  matchConfidence Float?
  matchType       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  offer    Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  position Position @relation(fields: [positionId], references: [id], onDelete: Cascade)

  @@unique([offerId, positionId])
  @@map("offer_items")
}

// ─── E-MAIL VERBINDUNG (Microsoft Graph) ──────────────────────────────────────────────────
model EmailConnection {
  id             String    @id @default(uuid())
  tenantId       String    @unique
  provider       String    @default("microsoft")
  accessToken    String?
  refreshToken   String?
  tokenExpiresAt DateTime?
  emailAddress   String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("email_connections")
}

// ─── PREISSPIEGEL (Price Comparison Export) ───────────────────────────────────────────────
model PriceComparison {
  id          String   @id @default(uuid())
  projectId   String   @unique
  tenantId    String
  exportPath  String?
  generatedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  @@map("price_comparisons")
}

// ─── SUBSCRIPTIONS / BILLING ─────────────────────────────────────────────────────────────────
model Subscription {
  id                   String             @id @default(uuid())
  tenantId             String             @unique
  plan                 Plan               @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  TRIALING
}

// ─── AUDIT LOG ──────────────────────────────────────────────────────────────────────────────
model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String
  userId     String?
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

// ─── PREISANOMALIEN (Price Anomalies) ────────────────────────────────────────────────────────
model PriceAnomaly {
  id             String    @id @default(uuid())
  projectId      String
  tenantId       String
  positionId     String?
  inquiryId      String?
  anomalyType    String
  severity       String
  description    String
  value          Decimal?  @db.Decimal(12, 4)
  referenceValue Decimal?  @db.Decimal(12, 4)
  resolvedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  position Position? @relation(fields: [positionId], references: [id], onDelete: SetNull)

  @@index([projectId, tenantId])
  @@index([tenantId, anomalyType])
  @@map("price_anomalies")
}

// ─── LIEFERANTEN-SCORE (Supplier Performance Score) ──────────────────────────────────────────
model SupplierScore {
  id               String   @id @default(uuid())
  supplierId       String   @unique
  tenantId         String
  responseRate     Decimal  @db.Decimal(5, 4)
  deadlineRate     Decimal  @db.Decimal(5, 4)
  avgMatchQuality  Decimal  @db.Decimal(5, 4)
  priceStability   Decimal  @db.Decimal(5, 4)
  totalInquiries   Int      @default(0)
  totalOffers      Int      @default(0)
  lastCalculatedAt DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("supplier_scores")
}

// ─── RECHNUNGEN (Invoices) ────────────────────────────────────────────────────────────────────
model Invoice {
  id            String    @id @default(uuid())
  projectId     String
  inquiryId     String
  tenantId      String
  invoiceNumber String
  totalNet      Decimal   @db.Decimal(12, 2)
  totalGross    Decimal   @db.Decimal(12, 2)
  vatRate       Decimal   @db.Decimal(5, 2)  @default(19)
  issuedAt      DateTime
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  inquiry      Inquiry       @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  invoiceItems InvoiceItem[]

  @@index([projectId, tenantId])
  @@map("invoices")
}

model InvoiceItem {
  id         String   @id @default(uuid())
  invoiceId  String
  positionId String?
  unitPrice  Decimal  @db.Decimal(12, 4)
  totalPrice Decimal  @db.Decimal(12, 2)
  notes      String?
  createdAt  DateTime @default(now())

  invoice  Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  position Position? @relation(fields: [positionId], references: [id], onDelete: SetNull)

  @@map("invoice_items")
}

// ─── ANFRAGE-VORLAGEN (Inquiry Templates) ─────────────────────────────────────────────────────
model InquiryTemplate {
  id             String   @id @default(uuid())
  tenantId       String
  name           String
  trade          String?
  subject        String
  bodyHtml       String
  attachmentPath String?
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([tenantId, trade])
  @@map("inquiry_templates")
}

// ─── BENCHMARK-PREISE (Anonymized Cross-Tenant Price Intelligence) ─────────────────────────────
model BenchmarkEntry {
  id               String   @id @default(uuid())
  trade            String
  positionTextHash String
  unit             String
  unitPriceMin     Decimal  @db.Decimal(12, 4)
  unitPriceP25     Decimal  @db.Decimal(12, 4)
  unitPriceMed     Decimal  @db.Decimal(12, 4)
  unitPriceP75     Decimal  @db.Decimal(12, 4)
  unitPriceMax     Decimal  @db.Decimal(12, 4)
  sampleCount      Int
  region           String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([trade, positionTextHash, unit])
  @@index([trade, unit])
  @@map("benchmark_entries")
}
