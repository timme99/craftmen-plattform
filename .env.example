# ─── DATABASE ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?schema=public"

# ─── SUPABASE ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[YOUR_ANON_KEY]"
SUPABASE_SERVICE_ROLE_KEY="[YOUR_SERVICE_ROLE_KEY]"

# ─── APP ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── MICROSOFT GRAPH API ──────────────────────────────────────────────────────
MICROSOFT_CLIENT_ID="[YOUR_AZURE_APP_CLIENT_ID]"
MICROSOFT_CLIENT_SECRET="[YOUR_AZURE_APP_CLIENT_SECRET]"
MICROSOFT_TENANT_ID="[YOUR_AZURE_TENANT_ID]"

# ─── PDF MICROSERVICE ────────────────────────────────────────────────────────
# Lokal: http://localhost:8000
# Vercel (experimentalServices): https://[deine-domain].vercel.app/_/pdf-service
PDF_SERVICE_URL="http://localhost:8000"
PDF_SERVICE_SECRET="[GENERATE_A_RANDOM_SECRET_32_CHARS]"

# ─── PDF SERVICE (für Vercel-Deployment) ─────────────────────────────────────
FASTAPI_ROOT_PATH="/_/pdf-service"

# ─── STRIPE (optional, for billing) ─────────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
