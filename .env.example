# ─── DATABASE ────────────────────────────────────────────────────────────────
# Transaction Pooler (Port 6543) — für App/Serverless
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Direkt-Verbindung (Port 5432) — nur für prisma migrate
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# ─── SUPABASE ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[YOUR_ANON_KEY]"
SUPABASE_SERVICE_ROLE_KEY="[YOUR_SERVICE_ROLE_KEY]"

# ─── APP ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── MICROSOFT GRAPH API ──────────────────────────────────────────────────────
MICROSOFT_CLIENT_ID="[YOUR_AZURE_APP_CLIENT_ID]"
MICROSOFT_CLIENT_SECRET="[YOUR_AZURE_APP_CLIENT_SECRET]"
MICROSOFT_TENANT_ID="[YOUR_AZURE_TENANT_ID]"

# ─── PDF MICROSERVICE ────────────────────────────────────────────────────────
# Lokal (Docker): http://localhost:8000
# Vercel: https://[deine-domain].vercel.app/_/pdf-service
PDF_SERVICE_URL="http://localhost:8000"
PDF_SERVICE_SECRET="[GENERATE_A_RANDOM_SECRET_32_CHARS]"

# ─── CLAUDE / ANTHROPIC ───────────────────────────────────────────────────────
# Genutzt vom Python-PDF-Service UND app-seitig (Next.js) für die KI-Assistenz:
# E-Mail-Vorformulierung, Positions-Zuordnungsvorschläge, Angebotsvergleich,
# PDF-/Angebots-Backup-Auslesen. Ohne diesen Key sind die KI-Buttons ausgeblendet.
ANTHROPIC_API_KEY="[YOUR_ANTHROPIC_API_KEY]"

# ─── STRIPE (optional, for billing) ─────────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
